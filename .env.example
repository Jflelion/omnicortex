# Base de datos
DATABASE_URL=postgresql://admin:change_me@localhost:5432/omnicortex_db

# Autenticación (genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Subida de documentos
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
LLM_MODEL=qwen2.5:3b
LLM_MAX_TOKENS=120
LLM_TIMEOUT_SECONDS=300
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_SECONDS=60

# CORS (orígenes del frontend, separados por comas)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Postgres para docker-compose (deben coincidir con DATABASE_URL)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=omnicortex_db

# URL de Ollama vista desde el contenedor de la API (opcional)
# DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
